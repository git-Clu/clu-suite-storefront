# Copy to .env and fill in.
# Without SMTP_HOST, mail is logged to the console instead of sent.

# Set by `clu-app` when deploy/app.conf has POSTGRES=yes. For local work point at your own database.
DATABASE_URL=postgres://clu_portal@127.0.0.1:5432/clu_portal

# Long random strings. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
KEY_PEPPER=
DOWNLOAD_SECRET=

# Previous pepper, only while rotating: verifies old hashes and re-hashes on next successful activation.
# KEY_PEPPER_OLD=

# Ed25519 signing key for licence tokens, as PEM. Generate a pair with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}))"
# The public key is pinned in clu-suite-core; changing it requires a Core release.
LICENCE_SIGNING_KEY=
# Short identifier published to clients so keys can be rotated without a Core release.
LICENCE_SIGNING_KID=clu-lic-2026-01

# Absolute path to the release artifacts (never relative: it must survive a deploy).
ARTIFACT_DIR=/home/dev_clu/web/portal.clu.gr/artifacts

# Merchant-of-Record webhook signature key.
MOR_WEBHOOK_SECRET=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@clu.gr
SMTP_PASS=
CONTACT_TO=info@clu.gr

# Staff panel at /admin. Without ADMIN_PASSWORD the login is disabled.
ADMIN_PASSWORD=
# Optional 2FA: base32 secret for Google Authenticator (or any TOTP app).
ADMIN_TOTP_SECRET=

# Optional: unlocks detailed /api/health output.
HEALTH_TOKEN=
